## Shared
# Backend base URL used by the web UI
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Server-side only (Next.js route handler) upstream for /api proxy
BACKEND_INTERNAL_URL=http://localhost:8000

## Backend (FastAPI)
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS_CSV=http://localhost:3000,http://127.0.0.1:3000

# Postgres (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/zeitgeist

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

## LLM (OpenAI-compatible)
# If unset, the system will fall back to non-LLM heuristics.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDINGS_MODEL=text-embedding-3-small

## Collectors (optional; missing creds => skipped)
# Reddit API (OAuth "script" / installed app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=zeitgeist-rsa-agent/0.1
# Optional (recommended for "script" apps): enables password grant.
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Optional: use PRAW wrapper for Reddit API calls.
REDDIT_USE_PRAW=false

# X API v2
X_BEARER_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

## QA/policy
QA_RISKY_TERMS_CSV=guarantee,guaranteed,100%,cure,miracle,instant,overnight,no risk,free money,legal advice,medical advice
QA_TRADEMARKS_CSV=

## Google Ads API (required for remote dry-run + push)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

